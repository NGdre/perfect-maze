{
  "extends": "@tsconfig/vite-react/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo",
    "paths": {
      "src/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@utils": ["src/utils"],
      "@generators/*": ["src/models/generators/*"],
      "@generators": ["src/models/generators/index"],
      "@solvers/*": ["src/models/solvers/*"],
      "@solvers": ["src/models/solvers/index"],
      "@models/*": ["src/models/*"],
      "@stores/*": ["src/stores/*"],
      "@stores": ["src/stores/index"],
      "@constants": ["src/constants"]
    }
  },
  "include": ["src"]
}
