{
  "name": "perfect-maze",
  "private": true,
  "version": "0.0.0",
  "description": "maze generator and path finder app with visualization controls",
  "repository": "https://github.com/NGdre/perfect-maze",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:favicons && tsc -b && vite build",
    "build:favicons": "node scripts/generate-favicon.cjs",
    "clean": "rm -rf dist node_modules/.cache",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noemit",
    "pre-build": "npm run type-check && npm run lint",
    "preview": "vite preview",
    "test": "jest",
    "test-ts-only": "jest --testPathPattern .ts$",
    "test-react-only": "jest --testPathPattern .tsx$"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "immer": "^10.1.1",
    "lodash": "^4.17.21",
    "ow": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-router": "^7.9.6",
    "react-tabs": "^6.1.0",
    "react-tooltip": "^5.30.0",
    "use-resize-observer": "^9.1.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@swc/core": "^1.11.20",
    "@swc/jest": "^0.2.37",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@tsconfig/vite-react": "^3.4.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "fast-check": "^4.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.40",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.34.4",
    "tailwindcss": "^3.4.7",
    "tsconfig-paths-jest": "^0.0.1",
    "typescript": "^5.9.3",
    "vite": "^5.3.4",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
